DISCORD_BOT_TOKEN=replace-me
DISCORD_GUILD_ID=
# Optional fallback review channel (defaults to the channel where commands are run)
# DISCORD_REVIEW_CHANNEL_ID=123456789012345678
# Comma-separated role IDs; empty = any member (not recommended)
DISCORD_ALLOWED_ROLE_IDS=
DISCORD_REVIEWER_ROLE_IDS=
# Seconds an empty voice channel is tolerated before the meeting auto-stops (default 60)
AUTO_STOP_GRACE_SECONDS=60

WHISPER_ASR_URL=https://your-whisper-asr.example.com
WHISPER_ASR_LANGUAGE=de
WHISPER_ASR_TIMEOUT_SECONDS=600
# Optional bearer token, needed when WHISPER_ASR_URL is a Paperspace gateway (e.g. paperspace.quandes.com)
WHISPER_ASR_TOKEN=
# Weekly whisper worker pre-warm is a separate cron container (bot/cron/), reads WHISPER_ASR_URL/TOKEN above.
# Schedule lives in bot/cron/crontab (default: Monday 18:10 Europe/Berlin).

MULTICA_BASE_URL=https://app.multica.ai
MULTICA_API_TOKEN=replace-me
MULTICA_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
MULTICA_TIMEOUT_SECONDS=20

TICKET_PROPOSAL_BACKEND=auto
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_API_TOKEN=replace-me
OPENCLAW_TIMEOUT_SECONDS=120
OPENCLAW_MODEL=openclaw/default
# Optional: export transcripts/summaries/tickets into the OpenClaw workspace
# (path inside the bot container; mount the workspace via docker-compose volumes)
# OPENCLAW_WORKSPACE_DIR=/openclaw-workspace

# Docker: join existing OpenClaw compose network (see README)
# OPENCLAW_DOCKER_NETWORK=openclaw-gfg2_default
# OPENCLAW_DOCKER_NETWORK_EXTERNAL=true
